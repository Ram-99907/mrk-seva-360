# MRK SEVA 360 — Environment Variables
# Copy this to .env.local and fill in real values

# ── Neon PostgreSQL (get from vercel.com → Storage → Neon) ───────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── App URL ───────────────────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173

# ── Staff Login Secret (any random string) ────────────────────────────────────
SESSION_SECRET=replace-with-random-32-char-string
